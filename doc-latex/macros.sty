\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{macros}

% metadata macros %{{{
\newcommand{\mytitle}{AnalysisTools User Manual}
\newcommand{\myauthor}{RNDr. Karel Šindelka, Ph.D.}
\newcommand{\myemail}{k.sindelka@gmail.com}
\newcommand{\mydate}{\today}
\newcommand{\myversion}{4.x} %}}}

% custom title page %{{{
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \centering
    \vspace*{\fill}
    {\Huge \bfseries \mytitle \par}
    \vskip 2em
    {\Large
      \lineskip .5em
      \begin{tabular}[t]{c}\myauthor\end{tabular}\par
    }
    {\large \myemail}
    \vskip 1.5em
    {\Large Version \myversion{} (\mydate) \par}
    \vspace*{\fill}
  \end{titlepage}%
} %}}}

% colors %{{{
\definecolor{lightgray}{rgb}{0.9,0.9,0.9}
\sethlcolor{lightgray}
\definecolor{dark-green}{rgb}{0,0.7,0}
\definecolor{dark-red}{rgb}{0.8,0,0}
\definecolor{dark-blue}{rgb}{0,0,0.9} %}}}

% math commands %{{{
\newcommand{\mb}{\mathbf}
\newcommand{\mr}{\mathrm} %}}}

% blue equation links %{{{
\colorlet{linkequation}{dark-blue}
\newcommand*{\SavedEqref}{}
\let\SavedEqref\eqref
\renewcommand*{\eqref}[1]{%
  \begingroup
    \hypersetup{
      linkcolor=linkequation,
      linkbordercolor=linkequation,
    }%
    \SavedEqref{#1}%
  \endgroup
} %}}}

% headers and footers %{{{
\newpagestyle{main}{
  \setheadrule{.4pt}
  \sethead[\thesection. \sectiontitle]% even-left
          []% even-center
          [\thechapter. \chaptertitle]% even-right
          {\thechapter. \chaptertitle}% odd-left
          {}% odd-center
          {\thesection. \sectiontitle}% odd-right
  \setfoot[]% even-left
          [\thepage]% even-center
          []% even-right
          {}% odd-left
          {\thepage}% odd-center
          {}% odd-right
} %}}}

% chapter headers without too much white space %{{{
\makeatletter
\def\@makechapterhead#1{
  {\parindent \z@ \raggedright \normalfont
   \vspace*{30pt}
   \Huge\bfseries \thechapter. #1
   \par\nobreak
   \vskip 20\p@
}}
\def\@makeschapterhead#1{
  {\parindent \z@ \raggedright \normalfont
   \Huge\bfseries #1
   \par\nobreak
   \vskip 20\p@
}}
\makeatother %}}}

% unnumbered chapter with toc entry %{{{
\def\chapwithtoc#1{
\chapter*{#1}
\addcontentsline{toc}{chapter}{#1}
} %}}}

% sectioning and toc depth %{{{
% number up to subsections (increase to 3 for subsubsections, 1 for sections only)
\setcounter{secnumdepth}{2}
% include up to subsections in toc (same depth scale as secnumdepth)
\setcounter{tocdepth}{2} %}}}

% figure placement %{{{
\setcounter{topnumber}{2}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.7} %}}}

% cross-reference helpers %{{{
\newcommand*{\fullref}[1]{\nameref*{#1} (\hyperref[{#1}]{\autoref*{#1}})}
\Crefname{figure}{Figure}{Figures}
\crefname{figure}{figure}{figures} %}}}

% keyword macros %{{{
\renewcommand{\tt}[1]{\texttt{\detokenize{#1}}\xspace}
\newcommand{\vcf}{\tt{vcf}}
\newcommand{\vsf}{\tt{vsf}}
\newcommand{\vscf}{\tt{vsf/vcf}}
\newcommand{\vtsf}{\tt{vtf/vsf}}
\newcommand{\vtcf}{\tt{vtf/vcf}}
\newcommand{\vtf}{\tt{vtf}}
\newcommand{\xyz}{\tt{xyz}}
\newcommand{\field}{\tt{FIELD}}
\newcommand{\data}{\tt{data}}
\newcommand{\ltrj}{\tt{lammpstrj}}
\newcommand{\AT}{\tt{AnalysisTools}}
\newcommand{\ttb}[1]{\textcolor{blue}{\texttt{#1}}}
\newcommand{\note}[1]{\vspace{-\baselineskip}\noindent{\footnotesize #1}}
% register macros for use inside \hl (soul package)
\soulregister\tt7
\soulregister\vcf7
\soulregister\vsf7
\soulregister\vscf7
\soulregister\vtsf7
\soulregister\vtcf7
\soulregister\vtf7
\soulregister\xyz7
\soulregister\field7
\soulregister\data7
\soulregister\ltrj7
\soulregister\AT7
\newcommand{\CallInit}[1]{\vspace{1em}\tt{#1}\tt{(parameters)}\vspace{-1em}}
\newcommand{\todo}[1]{{\sethlcolor{yellow}\hl{TODO: #1}}} %}}}

% listings setup %{{{
\definecolor{codebackground}{rgb}{0.95, 0.9, 0.95}
\lstset{
  numbers=left,
  numberstyle=\scriptsize,
  stepnumber=1,
  numbersep=10pt,
  backgroundcolor=\color{codebackground},
  frame=single,                    % just add some bit of color space
  framesep=5pt,                    % surrounding the code block (i.e., the
  rulecolor=\color{codebackground} % frame has the same colour as the block)
} %}}}

% number type shorthands %{{{
\newcommand{\Real}{$\mathcal{R}$}
\newcommand{\RealP}{$\mathcal{R}^+$}
\newcommand{\Int}{$\mathcal{I}$} %}}}

% custom column types %{{{
\newcolumntype{L}[1]{p{#1}@{\hspace{-23pt}}}
\newcolumntype{M}{>{\centering}p{0.2\textwidth}@{\hspace{-10pt}}} %}}}

% list settings %{{{
\renewcommand\labelenumi{(\theenumi)}
\setenumerate[1]{label={\arabic*)}}
\setenumerate[2]{label={\alph*)}, leftmargin=14pt}
\setenumerate[3]{label={\roman*)}, leftmargin=12pt}
\setenumerate{leftmargin=*, noitemsep}
\setitemize[3]{label=$\circ$}
\setitemize{leftmargin=*, noitemsep} %}}}

% fix \cline and \cmidrule with czech babel
\preto\tabular{\shorthandoff{-}}

